{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_UNLOCK_PRO": "1"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "plus": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_UNLOCK_PRO": "1"
      }
    },
    "preview": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_PLAN_SWITCH": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6802549751",
        "appleTeamId": "F8M552HN2V"
      }
    },
    "plus": {
      "ios": {
        "ascAppId": "6802549751",
        "appleTeamId": "F8M552HN2V"
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6802549751",
        "appleTeamId": "F8M552HN2V"
      }
    }
  }
}
