{
  "expo": {
    "name": "Rhythma",
    "slug": "rhythma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0012"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rhythma.cycle",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsUsageDescription": "Rhythma читає події й тренування з календаря, щоб звірити навантаження з циклом.",
        "NSCalendarsFullAccessUsageDescription": "Rhythma читає події й тренування з календаря, щоб звірити навантаження з циклом.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Rhythma може додати позначку циклу в календар, якщо ви дозволите."
      }
    },
    "android": {
      "package": "app.rhythma.cycle",
      "permissions": [
        "READ_CALENDAR"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D0012",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "Rhythma читає події й тренування з календаря, щоб звірити навантаження з циклом."
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "f1157231-8250-45b9-a28f-94f35c10b230"
      }
    },
    "owner": "iuliana.iagodka"
  }
}
